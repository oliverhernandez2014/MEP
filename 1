const state={subject:null,page:0,answers:{},matches:{},written:{}};
const $=id=>document.getElementById(id);
const screens=["home","instructions","exam","results"];
function show(id){screens.forEach(s=>$(s).classList.toggle("hidden",s!==id));window.scrollTo(0,0);}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function init(){
$("subjects").innerHTML=Object.entries(bank).map(([name,b])=>`<button class="subject" data-subject="${esc(name)}"><span>${b.icon}</span>${esc(name)}<small>${esc(b.desc)}</small></button>`).join("");
document.querySelectorAll("[data-subject]").forEach(btn=>btn.onclick=()=>{
state.subject=btn.dataset.subject;
document.querySelectorAll("[data-subject]").forEach(x=>x.classList.toggle("selected",x===btn));
$("selectedLabel").textContent="Seleccionada: "+state.subject;$("nextHome").disabled=false;
});
}
$("nextHome").onclick=()=>{
$("instructionTitle").textContent="Examen de "+state.subject;
show("instructions");
};
$("backHome").onclick=()=>show("home");
$("start").onclick=()=>{
state.page=0;state.answers={};state.matches={};state.written={};
renderPage();show("exam");
};
function info(){
if(state.page===0)return {title:"Parte I: Selección única",desc:"Lea cuidadosamente cada pregunta y marque con una X la opción correcta. Seleccione solamente una respuesta.",start:1,end:20};
if(state.page===1)return {title:"Parte II: Relacionar",desc:"Una cada elemento de la columna izquierda con la respuesta correcta de la columna derecha.",start:21,end:25};
return {title:"Parte III: Respuesta escrita",desc:"Lea cada pregunta y escriba su respuesta de forma clara y completa.",start:26,end:30};
}
function renderPage(){
const b=bank[state.subject],p=info();
$("partLabel").textContent=state.subject+" · Página "+(state.page+1)+" de 3";
$("partTitle").textContent=p.title;$("partInstructions").textContent=p.desc;
$("pageLabel").textContent=`Preguntas ${p.start}–${p.end} de 30`;
$("progressBar").style.width=((state.page+1)/3*100)+"%";
$("previous").disabled=state.page===0;
$("next").textContent=state.page===2?"Finalizar examen":"Siguiente →";
if(state.page===0){
$("questions").innerHTML=b.mc.map((q,i)=>`<div class="question"><h3>${i+1}. ${esc(q[0])}</h3>${q[1].map((o,j)=>`<label class="option"><input type="radio" name="q${i}" value="${j}" ${state.answers[i]===j?"checked":""}><span><b>${"ABCD"[j]}.</b> ${esc(o)}</span></label>`).join("")}</div>`).join("");
$("questions").querySelectorAll("input").forEach(x=>x.onchange=()=>state.answers[+x.name.slice(1)]=+x.value);
}else if(state.page===1){
const choices=b.match.map((x,i)=>({text:x[1],id:i})).sort((a,b)=>a.text.localeCompare(b.text,"es"));
$("questions").innerHTML=b.match.map((m,i)=>`<div class="matchrow"><b>${i+21}. ${esc(m[0])}</b><select data-m="${i}"><option value="">Selecciona una definición…</option>${choices.map(c=>`<option value="${c.id}" ${state.matches[i]===c.id?"selected":""}>${esc(c.text)}</option>`).join("")}</select></div>`).join("");
$("questions").querySelectorAll("[data-m]").forEach(x=>x.onchange=()=>state.matches[+x.dataset.m]=x.value===""?null:+x.value);
}else{
$("questions").innerHTML=b.written.map((q,i)=>`<div class="question"><h3>${i+26}. ${esc(q[0])}</h3><textarea data-w="${i}" placeholder="Escribe tu respuesta…">${esc(state.written[i]||"")}</textarea></div>`).join("");
$("questions").querySelectorAll("[data-w]").forEach(x=>x.oninput=()=>state.written[+x.dataset.w]=x.value);
}
}
$("previous").onclick=()=>{if(state.page>0){state.page--;renderPage();}};
$("next").onclick=()=>{
if(state.page<2){state.page++;renderPage();window.scrollTo(0,0);}
else finish();
};
function norm(s){return String(s||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[.,;:!?¿¡()[\]{}]/g," ").replace(/\s+/g," ").trim();}
function finish(){
const b=bank[state.subject];
let blank=0;
b.mc.forEach((q,i)=>{if(state.answers[i]===undefined)blank++;});
b.match.forEach((q,i)=>{if(state.matches[i]===undefined||state.matches[i]===null)blank++;});
b.written.forEach((q,i)=>{if(!String(state.written[i]||"").trim())blank++;});
if(blank&&!confirm(`Tienes ${blank} pregunta(s) sin responder. ¿Finalizar de todas formas?`))return;
showResults();show("results");
}
function showResults(){
const b=bank[state.subject];let correct=0,wrong=0,omitted=0,pending=0,items=[];
function add(num,q,student,expected,explanation,status){
if(status==="correct")correct++;else if(status==="wrong")wrong++;else if(status==="omitted")omitted++;else pending++;
if(status!=="correct")items.push({num,q,student,expected,explanation,status});
}
b.mc.forEach((q,i)=>{
const a=state.answers[i],s=a===undefined?"omitted":a===q[2]?"correct":"wrong";
add(i+1,q[0],a===undefined?"Sin respuesta":`${"ABCD"[a]}. ${q[1][a]}`,`${"ABCD"[q[2]]}. ${q[1][q[2]]}`,q[3],s);
});
b.match.forEach((q,i)=>{
const a=state.matches[i],s=a===undefined||a===null?"omitted":a===i?"correct":"wrong";
add(i+21,q[0],a===undefined||a===null?"Sin respuesta":b.match[a][1],q[1],"Relaciona el concepto con su definición. Lee ambas columnas para recordar la relación.",s);
});
b.written.forEach((q,i)=>{
const ans=String(state.written[i]||"").trim(),n=norm(ans),expected=norm(q[1]);
let s=!ans?"omitted":(n===expected||(q[2]||"").split("|").map(norm).includes(n))?"correct":"pending";
add(i+26,q[0],ans||"Sin respuesta",q[1],q[3],s);
});
const graded=30-pending,percent=graded?Math.round(correct/graded*100):0;
$("scoreArea").innerHTML=`<div class="score">${correct}/30</div><p>Respuestas correctas calificadas automáticamente.</p><div class="stats"><div class="stat">Correctas<b>${correct}</b></div><div class="stat">Incorrectas<b>${wrong}</b></div><div class="stat">Omitidas<b>${omitted}</b></div><div class="stat">Por revisar<b>${pending}</b></div></div><h3>${percent}% de aciertos entre respuestas calificadas automáticamente</h3><p class="muted">Las respuestas abiertas que no se pueden evaluar con seguridad quedan pendientes de revisión, en lugar de marcarse automáticamente como incorrectas.</p>`;
$("review").innerHTML="<h3>Revisión de errores y respuestas pendientes</h3>"+(items.length?items.map(r=>`<div class="review ${r.status==="pending"?"pending":""}"><b>Pregunta ${r.num}: ${esc(r.q)}</b><p><b>Tu respuesta:</b> ${esc(r.student)}</p><p><b>Respuesta esperada:</b> ${esc(r.expected)}</p><p><b>Explicación:</b> ${esc(r.explanation)}</p><p><b>Estado:</b> ${r.status==="pending"?"Pendiente de revisión":r.status==="omitted"?"Omitida":"Incorrecta"}</p></div>`).join(""):"<p>¡Excelente! No hay respuestas incorrectas u omitidas.</p>");
}
$("retry").onclick=()=>{$("start").click();};
$("change").onclick=()=>{state.subject=null;init();$("selectedLabel").textContent="Ninguna materia seleccionada";$("nextHome").disabled=true;show("home");};
init();
</script>
</body>
</html>
