<title>Examen escolar interactivo — Sexto grado</title>
<style>
:root {
  --primary: #4f46e5;
  --background: #f3f5fb;
  --text: #1e293b;
  --border: #dce2ed;
  --green: #15803d;
  --red: #dc2626;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, sans-serif;
  line-height: 1.6;
}
header {
  background: white;
  text-align: center;
  padding: 22px 12px;
  border-bottom: 1px solid var(--border);
}
header h1 { margin: 0; font-size: 25px; }
header p { color: #64748b; margin-bottom: 0; }
main { max-width: 900px; margin: 25px auto; padding: 0 14px; }
.card {
  background: white;
  padding: 24px;
  border-radius: 16px;
  border: 1px solid var(--border);
  box-shadow: 0 5px 20px #00000008;
  margin-bottom: 18px;
}
h2 { margin-top: 0; }
.grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.subject {
  background: white;
  border: 2px solid var(--border);
  border-radius: 13px;
  padding: 18px;
  font-size: 17px;
  font-weight: bold;
  text-align: left;
  cursor: pointer;
}
.subject span { display: block; font-size: 30px; }
.subject.selected {
  border-color: var(--primary);
  background: #eef2ff;
}
button {
  border: 0;
  border-radius: 9px;
  padding: 12px 18px;
  font-size: 15px;
  font-weight: bold;
  cursor: pointer;
}
.primary { background: var(--primary); color: white; }
.secondary { background: #e2e8f0; color: var(--text); }
button:disabled { opacity: .4; cursor: not-allowed; }
.actions {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-top: 22px;
}
.hidden { display: none !important; }
.muted { color: #64748b; }
.progress {
  background: #e2e8f0;
  height: 8px;
  border-radius: 20px;
  overflow: hidden;
  margin: 14px 0 22px;
}
#progressBar {
  width: 0;
  height: 100%;
  background: var(--primary);
  transition: width .2s;
}
.question {
  padding: 16px 0;
  border-bottom: 1px solid var(--border);
}
.question h3 { font-size: 16px; }
.option {
  display: flex;
  gap: 10px;
  padding: 11px;
  margin: 7px 0;
  border: 1px solid var(--border);
  border-radius: 9px;
  cursor: pointer;
}
.option:has(input:checked) {
  background: #eef2ff;
  border-color: var(--primary);
}
input[type=radio] { accent-color: var(--primary); }
select, textarea {
  width: 100%;
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 9px;
  font: inherit;
  background: white;
}
textarea { min-height: 90px; resize: vertical; }
.matchrow {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
  margin: 13px 0;
  align-items: center;
}
.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.stat {
  padding: 12px;
  border: 1px solid var(--border);
  border-radius: 10px;
}
.stat b { display: block; font-size: 24px; }
.score { font-size: 42px; color: var(--primary); font-weight: bold; }
.review {
  border: 1px solid var(--border);
  border-left: 5px solid var(--red);
  border-radius: 10px;
  padding: 15px;
  margin: 12px 0;
}
.review.pending { border-left-color: #d97706; }
.review.correct { border-left-color: var(--green); }
@media(max-width:600px) {
  .grid, .stats { grid-template-columns: 1fr 1fr; }
  .matchrow { grid-template-columns: 1fr; }
  .actions button { flex: 1; }
}
</style>
</head>
